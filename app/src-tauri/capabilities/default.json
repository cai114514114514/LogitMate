{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the pet window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "dialog:allow-open",
    "dialog:allow-message"
  ]
}
